# ============================================================
#  KITAQ ONLINE — contoh .env untuk SHARED/CLOUD HOSTING
#  Salin menjadi .env di server, lalu: php artisan key:generate
# ============================================================
APP_NAME="KITAQ ONLINE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://ujian.sekolahanda.sch.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database dari panel hosting (MySQL/MariaDB)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456_kitaq
DB_USERNAME=u123456_kitaq
DB_PASSWORD=

# Shared hosting: tanpa Redis → semua pakai database/file
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@sekolahanda.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------- KITAQ ONLINE ----------------
KITAQ_VERSION=1.0.0
KITAQ_REALTIME=polling
KITAQ_MONITOR_POLL_SEC=4
KITAQ_HEARTBEAT_SEC=15
KITAQ_HEARTBEAT_GAP_SEC=60
KITAQ_OFFLINE_LOCK_SEC=0

KITAQ_SHIELD_PRESET=standar
KITAQ_MAX_WARNINGS=2

KITAQ_TOKEN_ROTATION=900
KITAQ_LOGIN_PER_MINUTE=5
KITAQ_LOGIN_LOCKOUT=10
KITAQ_LOGIN_LOCKOUT_MINUTES=15
KITAQ_FORCE_CHANGE_PASSWORD=false

# Kosongkan bila siswa boleh ujian dari mana saja. Isi IP publik sekolah untuk membatasi.
KITAQ_IP_ALLOWLIST=
KITAQ_TRUST_PROXIES=*
KITAQ_LOG_RETENTION_DAYS=365
